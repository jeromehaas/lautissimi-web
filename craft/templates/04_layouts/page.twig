{% set metaTitle = metaTitle is defined ? metaTitle : 'LAUTISSIMI' %}
{% set metaDescription = metaDescription is defined ? metaDescription : '' %}

<!DOCTYPE html>
<html lang="{{ currentSite.language }}">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="stylesheet" href="/css/main.min.css?v=3.5">
    <link rel="icon" href="/media/favicons/favicon.ico">
    <title>{{ metaTitle }}</title>
		<meta name="description" content="{{ metaDescription }}">
		<script defer data-domain="lautissimi.ch" src="https://plausible.io/js/plausible.js"></script>
</head>

<body class="body page js-page">
	<div class="page__transition-layer"></div>

	{% block main %} {% endblock %}

<div class="news-banner js-news-banner">
    <img class="news-banner__close" src="/media/graphics/icons/icon-close.svg" alt="">

    <div class="news-card js-news-card" data-index="0">
        <h4 class="heading heading--h4 heading--beige-medium news-banner__heading js-heading">
            {% if currentSite.language == 'de' %} Aktuell {% endif %}
            {% if currentSite.language == 'en' %} News {% endif %}
        </h4>
        <p class="paragraph paragraph--beige-dark news-banner__text paragraph--small">
            {% if currentSite.language == 'de' %}Zwei starke Marken für hochwertige Objekteinrichtungen schliessen sich zusammen. Per Januar 2024 übernimmt LAUTISSIMI die Firma D.O.M. Design.Objekt.Möbel GmbH.{% endif %}
            {% if currentSite.language == 'en' %}Two strong brands for high-quality object interior incorporates. As of January 2024 LAUTISSIMI acquires the company D.O.M. GmbH.{% endif %}
        </p>
        <img class="news-banner__image" src="/media/graphics/logos/logo-dom-black.svg" alt="DOM">
    </div>

    <div class="news-card js-news-card" data-index="1">
        <h4 class="heading heading--h4 heading--beige-medium news-banner__heading js-heading">
            {% if currentSite.language == 'de' %} Aktuell {% endif %}
            {% if currentSite.language == 'en' %} News {% endif %}
        </h4>
        <p class="paragraph paragraph--beige-dark news-banner__text paragraph--small">
            {% if currentSite.language == 'de' %}Fertigstellung Beauftragung Kanton AG. Labor/Bürogebäude in Unterentfelden mit massgeschneiderten Büromöbel in Zusammenarbeit mit Markus Schietsch Architekten Zürich.{% endif %}
            {% if currentSite.language == 'en' %}Completion of commissioning by swiss canton Aargau-Laboratory/office in Unterentfelden completed with our customized furnitures in collaboration with Markus Schietsch architects Zuerich{% endif %}
        </p>
        <img class="news-banner__image" src="/media/images/kanton-labor-unterentfelden.webp" alt="Kanton Labor Unterentfelden">
    </div>

    <div class="news-card js-news-card" data-index="2">
        <h4 class="heading heading--h4 heading--beige-medium news-banner__heading js-heading">
            {% if currentSite.language == 'de' %} Aktuell {% endif %}
            {% if currentSite.language == 'en' %} News {% endif %}
        </h4>
        <p class="paragraph paragraph--beige-dark news-banner__text paragraph--small">
            {% if currentSite.language == 'de' %}Mein Partner René Sigrist wird LAUTISSIMI per 1. November 2024 aus eigenen Wunsch verlassen. Ich bedanke mich für die Jahre der guten Zusammenarbeit und wünsche viel Erfolg für die Zukunft.{% endif %}
            {% if currentSite.language == 'en' %}Business partner René Sigrist will leave us on Nov 1st 2024 at his own request. I would like to thank him for the years of good cooperation and wish him every success in the future.{% endif %}
        </p>
    </div>
     <div class="news-card js-news-card" data-index="2">
        <h4 class="heading heading--h4 heading--beige-medium news-banner__heading js-heading">
            {% if currentSite.language == 'de' %} Aktuell {% endif %}
            {% if currentSite.language == 'en' %} News {% endif %}
        </h4>
        <p class="paragraph paragraph--beige-dark news-banner__text paragraph--small">
            {% if currentSite.language == 'de' %}Baustelle Bergrestaurant LaMotta Scuol auf über 2000m Höhe mit Eröffnung im Dezember 2024 schreitet voran.{% endif %}
            {% if currentSite.language == 'en' %}Constuction site of Mountain-Restaurant LaMotta Scuol at over 2000m altitude With opening in December 2024 is progressing.{% endif %}
        </p>
        <img class="news-banner__image" src="/media/images/lamotta-scuol.webp" alt="LaMotta Scoul">
    </div>
</div>

  <script src="/js/main.build.js?v=3.5"></script>
  <script src="https://api.mailxpert.ch/forms.js"></script>
  <script type="text/javascript">
    mailxpert.forms.include({
      src: 'https://web.swissnewsletter.ch/e/b0dc198418d18fd9/de/form/5eed8b64-b8eb-48de-80da-419ae17bad9b.html?render=container',
      element: document.getElementById('formContentId'),
    });
  </script>


</body>

</html>